{
  "name": "odatav4adaptor.client",
  "version": "1.0.0",
  "description": "TypeScript client sample that binds Syncfusion Gantt to a remote ASP.NET Core OData V4 service using ODataV4Adaptor.",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode=development --open",
    "build": "webpack --mode=development --watch",
    "release": "webpack --mode=production",
    "publish": "npm run release && dotnet publish -c Release"
  },
  "keywords": [
    "typescript",
    "gantt",
    "syncfusion",
    "ej2",
    "odata",
    "odatav4",
    "adaptor"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@syncfusion/ej2-data": "*",
    "@syncfusion/ej2-gantt": "*",
    "@types/node": "*"
  },
  "devDependencies": {
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "7.1.2",
    "html-webpack-plugin": "5.6.0",
    "mini-css-extract-plugin": "2.9.0",
    "style-loader": "^4.0.0",
    "ts-loader": "9.5.1",
    "typescript": "5.4.5",
    "webpack": ">=5.104.1",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "^5.2.0"
  }
}
